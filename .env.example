# =============================================================================
# Desenvolvimento local — copie para .env e preencha com valores reais
# =============================================================================

UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Concilio <onboarding@resend.dev>"

APP_URL="http://localhost:3000"
NODE_ENV="development"

# Gere valores longos e DIFERENTES entre si (mín. 24 caracteres):
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   OpenSSL:    openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"
CODE_HASH_SECRET="troque-por-outro-segredo-longo"
CSRF_SECRET="troque-por-um-terceiro-segredo-longo"

# Conta admin inicial (usada só na 1ª vez, se ainda não existir conta salva no Redis).
# Depois disso, altere usuário e senha em Admin → Conta do administrador.
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin@@"

# Opcional — apenas desenvolvimento: força armazenamento em memória (dados não persistem).
# USE_DEV_MEMORY_STORE="true"

# =============================================================================
# Produção (Vercel) — veja docs/DEPLOY_VERCEL.md
# =============================================================================
#
# Obrigatórias na Vercel (Settings → Environment Variables):
#   UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN  → Upstash real (não placeholders)
#   RESEND_API_KEY, EMAIL_FROM                        → domínio verificado no Resend
#   APP_URL                                           → https://seu-projeto.vercel.app (sem barra final)
#   AUTH_SECRET, CODE_HASH_SECRET, CSRF_SECRET        → três segredos distintos
#   SEED_ADMIN_LOGIN, SEED_ADMIN_PASSWORD             → senha forte em produção
#
# APP_URL: após o 1º deploy, atualize com a URL final e faça Redeploy (links de e-mail).
#
# EMAIL_FROM em produção (exemplo):
#   EMAIL_FROM="Concilio <noreply@votacao.suaigreja.org.br>"
#
# NÃO definir em produção:
#   USE_DEV_MEMORY_STORE
#   NODE_ENV (a Vercel define production automaticamente)
#
# Nunca commite o arquivo .env — apenas este .env.example.
