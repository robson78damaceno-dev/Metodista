generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
}

model Election {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      ElectionStatus @default(DRAFT)
  opensAt     DateTime?
  closesAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  candidates  Candidate[]
  votingCodes VotingCode[]
  spentBallots SpentBallot[]

  @@index([status])
  @@map("elections")
}

model Candidate {
  id          String   @id @default(uuid()) @db.Uuid
  electionId  String   @db.Uuid
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votes    Vote[]

  @@index([electionId, active])
  @@index([electionId, sortOrder])
  @@map("candidates")
}

model VotingCode {
  id         String    @id @default(uuid()) @db.Uuid
  electionId String    @db.Uuid
  codeHash   String    @unique
  active     Boolean   @default(true)
  used       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  usedAt     DateTime?

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId, active, used])
  @@map("voting_codes")
}

model Vote {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @db.Uuid
  feedback    String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId])
  @@index([createdAt])
  @@map("votes")
}

model SpentBallot {
  id        String   @id @default(uuid()) @db.Uuid
  electionId String  @db.Uuid
  tokenHash String   @unique
  usedAt    DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
  @@map("spent_ballots")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@map("admin_users")
}

model RateLimitBucket {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  action    String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, action])
  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model CsrfToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("csrf_tokens")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}
